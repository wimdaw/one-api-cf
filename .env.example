# ============================================================
# one-api-cf 环境变量示例 (复制为 .env 使用)
# ============================================================

# ----- 数据库选择 -----
# DB_DRIVER: sqlite(默认) | mysql | postgres
# 不填则默认使用 sqlite
DB_DRIVER=sqlite

# --- SQLite 配置 (DB_DRIVER=sqlite) ---
# 数据库文件路径(容器内)
# DB_FILE=/app/data/one-api-cf.db

# --- MySQL 配置 (DB_DRIVER=mysql) ---
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=rootpass
# DB_NAME=one_api_workers

# --- PostgreSQL 配置 (DB_DRIVER=postgres) ---
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=pgpass
# DB_NAME=one_api_workers

# ----- 应用配置 -----
# 管理后台登录令牌(强烈建议改为长随机串)
ADMIN_TOKEN=admin

# 服务端口
# PORT=3000