{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one-api-cf",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "secrets": {
    "required": [
      "ADMIN_TOKEN"
    ]
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // KV 部署模式: 用 Cloudflare KV 作为数据库 (sql-asm.js 内存库 + KV 持久化)
  // 把下方 id 替换为你自己的 KV namespace id
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
